{
  "name": "ROS 2 AMR Dev Environment",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "dockerComposeFile": "../docker-compose.yaml",
  "service": "ros2_amr_env",
  "workspaceFolder": "/home/ubuntu/git/amr",
  "remoteUser": "ubuntu",

  "workspaceMount": "source=${localEnv:HOME}/ros2_ws,target=/home/ubuntu/colcon_ws,type=bind",
  "workspaceMount": "source=${localEnv:HOME}/git,target=/home/ubuntu/git,type=bind",

  "appPort": [
    "6080:80",
    "5901:5901",
    "10022:22",
  ],

  "postStartCommandUser": "root",
  "postStartCommand": "sudo /startup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "dotjoshjohnson.xml",
        "redhat.vscode-yaml"
      ]
    }
  },
  "portsAttributes": {
    "6080": {
      "label": "80"
    }
  }
}
